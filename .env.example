# Copie este arquivo para .env e preencha com os seus valores.
# NUNCA versione o arquivo .env.

# --- Opção 1: Ollama local (desenvolvimento e testes) ---
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3.5:4b-q4_K_M

# --- Opção 2: LLM institucional (somente de dentro de um container no Devel) ---
# LLM_BASE_URL=https://llm-internal.softex:9001
# LLM_MODEL=qwen3.5:9b-q4_K_M

# Tempo máximo de espera pela resposta do LLM, em segundos (padrão: 120).
# O modelo local em CPU pode levar cerca de 1 minuto por e-mail.
LLM_TIMEOUT=120

# Parâmetros de geração (opcionais; deixe vazio para usar o padrão).
# Temperatura: 0 a 2. Valores baixos deixam as respostas mais estáveis (padrão: 0.2).
LLM_TEMPERATURE=0.2
# Limite de tokens gerados na resposta (padrão: 512).
LLM_MAX_TOKENS=512

# Chave de acesso, se o servidor exigir. O Ollama local e o Devel não exigem;
# deixe vazio.
LLM_API_KEY=
