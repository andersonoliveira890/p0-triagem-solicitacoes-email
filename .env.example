# Copie este arquivo para .env e preencha com os seus valores.
# NUNCA versione o arquivo .env.

# --- Opção 1: Ollama local (desenvolvimento e testes) ---
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3.5:4b-q4_K_M

# --- Opção 2: LLM institucional (somente de dentro de um container no Devel) ---
